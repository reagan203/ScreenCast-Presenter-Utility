<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationVisualStyles>true</ApplicationVisualStyles>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <RootNamespace>ScreenCastPresenter</RootNamespace>

    <!-- Memory budget (NFR-01..03): workstation, non-concurrent GC keeps the heap and thread count small. -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <!-- Tiered JIT later recompiles hot code a second time (plus profiling data): measured +7 MB of
         permanent native memory after a busy minute. Compiling once, fully optimised, keeps
         presenting at ~13 MB; startup stays ~420 ms (NFR-07 allows 1 s). See docs/TESTING.md. -->
    <TieredCompilation>false</TieredCompilation>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.CsWin32" Version="0.3.371">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Vortice.Direct2D1" Version="3.8.3" />
    <PackageReference Include="Vortice.Direct3D11" Version="3.8.3" />
    <PackageReference Include="Vortice.DXGI" Version="3.8.3" />
  </ItemGroup>

  <ItemGroup>
    <AdditionalFiles Include="Interop\NativeMethods.txt" />
    <AdditionalFiles Include="Interop\NativeMethods.json" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ScreenCastPresenter.Tests" />
  </ItemGroup>

</Project>
