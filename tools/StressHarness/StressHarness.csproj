<Project Sdk="Microsoft.NET.Sdk">

  <!-- Drives the real SCP app through its global shortcuts under load and checks the SRS budgets.
       Test tool only: it may copy frames to CPU memory (flash detection); the product never does. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <ServerGarbageCollection>false</ServerGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Vortice.Direct3D11" Version="3.8.3" />
    <PackageReference Include="Vortice.DXGI" Version="3.8.3" />
  </ItemGroup>

</Project>
